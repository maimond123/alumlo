# Supabase (the 2025 project is deleted; these point at local Postgres in the rebuild)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter serves both the chat models and embeddings (baai/bge-m3).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_SITE_URL=

# Model overrides. Defaults are Chinese open-source models on OpenRouter;
# see web/app/config/models.ts for why each one was picked.
ALUMLO_MODEL_CLASSIFY=
ALUMLO_MODEL_TRANSLATE=
ALUMLO_MODEL_CHAT=
# Leave empty unless a replacement fine-tune exists; callers fall back to prompt-only.
ALUMLO_MODEL_FINETUNED=
