# Supabase (the 2025 project is deleted; these point at local Postgres in the rebuild)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI: query translation + embeddings
OPENAI_API_KEY=

# Model overrides. Defaults are the models the 2025 system ran on; set these to
# whatever your OpenAI project can actually reach.
ALUMLO_MODEL_CLASSIFY=
ALUMLO_MODEL_TRANSLATE=
ALUMLO_MODEL_CHAT=
# Leave empty unless a replacement fine-tune exists; callers fall back to prompt-only.
ALUMLO_MODEL_FINETUNED=
